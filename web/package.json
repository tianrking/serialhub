{
  "name": "serialhub-web",
  "private": true,
  "version": "0.2.1",
  "description": "SerialHub 本地设备共享与串口调试工作台",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "npm run check:i18n",
    "build": "tsc -b && vite build",
    "lint": "oxlint src",
    "check:i18n": "node --experimental-strip-types scripts/check-i18n.ts",
    "test": "node --experimental-strip-types --import ./locale-fixture.ts --test",
    "test:e2e": "playwright test",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
